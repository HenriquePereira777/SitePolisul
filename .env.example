# ============================================================
# POLISUAL ALIMENTOS — Variáveis de Ambiente
# ============================================================
# IMPORTANTE: Copie este arquivo como .env e preencha os valores.
# NUNCA faça commit do arquivo .env com dados reais!
# O .gitignore já ignora .env automaticamente.
# ============================================================

# Banco de dados
MYSQL_ROOT_PASSWORD=TROQUE_ROOT_PASSWORD_AQUI
MYSQL_USER=polisual
MYSQL_PASSWORD=TROQUE_SENHA_MYSQL_AQUI

# JWT — gere uma chave aleatória forte (mínimo 32 caracteres)
# Sugestão: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_CHAVE_ALEATORIA_FORTE_AQUI
JWT_EXPIRATION=86400000

# CORS — domínios permitidos (sem espaços)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# Frontend
REACT_APP_API_URL=http://localhost:8080

# E-mail (SMTP) — aviso de novos contatos do site (Hostinger, porta 465 = SSL)
# Hostinger: smtp.hostinger.com, porta 465, SSL/TLS
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USERNAME=polisulalimentos@polisulalimentos.com.br
MAIL_PASSWORD=sua-senha-do-email-aqui
MAIL_FROM=polisulalimentos@polisulalimentos.com.br
MAIL_TO=polisulalimentos@polisulalimentos.com.br

# ── Painel administrador (/admin) ───────────────────────────────────────────
# Ao subir o backend, o usuário abaixo é criado/atualizado com essa senha (mín. 8 caracteres).
ADMIN_EMAIL=admin@polisual.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
