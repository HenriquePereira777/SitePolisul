import React from 'react';
import { Link } from 'react-scroll';
import { FiCamera } from 'react-icons/fi';
import { WheatIcon, SproutIcon } from '../icons';

const stats = [
  { valor: '15+',   label: 'Anos no mercado' },
  { valor: '50k',   label: 'Toneladas/ano' },
  { valor: '300+',  label: 'Clientes ativos' },
  { valor: 'RS',    label: 'Rio Grande do Sul' },
];

export default function Hero() {
  return (
    <section id="hero" className="relative min-h-screen flex items-center overflow-hidden pt-[72px]
                                   bg-gradient-to-br from-green-50 via-green-100 to-[#97C459]">
      {/* Círculos decorativos */}
      <div className="absolute top-0 right-0 w-[400px] h-[400px] bg-white/10 rounded-full -translate-y-1/4 translate-x-1/4" />
      <div className="absolute bottom-0 left-0 w-[250px] h-[250px] bg-green-600/10 rounded-full translate-y-1/3 -translate-x-1/4" />

      <div className="relative z-10 grid items-center w-full max-w-6xl gap-16 px-6 py-16 mx-auto md:grid-cols-2">

        {/* Conteúdo */}
        <div className="text-ellipsis animate-fade-in">
          <span className="section-tag">Do campo à sua mesa</span>
          <h1 className="mb-5 text-4xl font-bold leading-tight text-green-900 font-display md:text-5xl xl:text-6xl">
            Alimentos de qualidade,<br />direto da terra gaúcha
          </h1>
          <p className="max-w-md mb-8 text-base leading-relaxed text-green-800">
            Produzimos arroz e soja com excelência, tecnologia e respeito ao
            meio ambiente. Tradição agrícola que nutre famílias brasileiras.
          </p>
          <div className="flex flex-wrap gap-3 mb-12">
            <Link to="produtos" smooth duration={600} offset={-80} className="btn-primary">
              Conheça os produtos
            </Link>
            <Link to="sobre" smooth duration={600} offset={-80}
              className="btn-outline !bg-white/50">
              Nossa história
            </Link>
          </div>

          {/* Stats */}
          <div className="grid grid-cols-4 gap-4 pt-8 border-t border-green-600/20">
            {stats.map(s => (
              <div key={s.label}>
                <span className="block text-2xl font-bold text-green-900 font-display">{s.valor}</span>
                <span className="text-[11px] text-green-600 font-medium">{s.label}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Área visual */}
        <div className="hidden md:flex relative h-[420px] items-center justify-center">
          {/* Badges flutuantes */}
          <div className="absolute left-0 z-10 flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-green-800 bg-white rounded-full shadow-md top-8">
            <WheatIcon size={16} /> Arroz Tipo 1
          </div>
          <div className="absolute right-0 z-10 flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-green-800 bg-white rounded-full shadow-md bottom-12">
            <SproutIcon size={16} /> Soja Orgânica
          </div>

          {/* Placeholder da imagem */}
          <div className="absolute flex flex-col items-center justify-center gap-3 text-green-800 border-2 border-dashed inset-5 bg-white/30 rounded-2xl border-green-600/30">
            <FiCamera size={44} />
            <p className="text-sm text-center">Adicione uma foto<br />da lavoura aqui</p>
          </div>
        </div>
      </div>
    </section>
